{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coder's Bible",
  "version": "2.1.0",
  "identifier": "com.vrtxomega.coders-bible",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "Coder's Bible",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "coders_bible.db": "coders_bible.db"
    },
    "macOS": {
      "entitlements": "",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": "",
      "signingIdentity": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMDUzQjE0Qjk5NzhBRkQKUldRbXhVNGtUQXZ4ZWh4N2F5d1B5ZFBXWU10eXBUYmVlNURRVmFnQWpQN2VUUXdDb2wzZzJ5aEEK",
      "endpoints": [
        "https://github.com/vrtxomega/the-coders-bible/releases/latest/download/latest.json"
      ]
    }
  }
}
